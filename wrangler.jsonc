{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurexia",
  "compatibility_date": "2026-07-18",
  "observability": {
    "enabled": true
  },
  "main": "src/server.js",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
