        { id: 82, name: 'Cobie Smulders', specialization: 'Resilience Coach', experience: '11 years', rating: 4.9, city: 'vancouver', image: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&q=80&w=200' },
        { id: 83, name: 'Ryan Gosling', specialization: 'Quiet Confidence Mentor', experience: '13 years', rating: 5.0, city: 'vancouver', image: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&q=80&w=200' },

        // Canada - Montreal
        { id: 84, name: 'Celine Dion', specialization: 'Emotional Performance Therapy', experience: '25 years', rating: 5.0, city: 'montreal', image: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=200' },
        { id: 85, name: 'Justin Trudeau', specialization: 'Empathetic Leadership Coach', experience: '10 years', rating: 4.6, city: 'montreal', image: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&q=80&w=200' },
        { id: 86, name: 'Leonard Cohen', specialization: 'Deep Existential Counselor', experience: '20 years', rating: 4.9, city: 'montreal', image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=200' },

        // Canada - Calgary
        { id: 87, name: 'Bret Hart', specialization: 'Persistence and Grit Coach', experience: '20 years', rating: 4.9, city: 'calgary', image: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&q=80&w=200' },
        { id: 88, name: 'Elisha Cuthbert', specialization: 'Stress Management Expert', experience: '12 years', rating: 4.7, city: 'calgary', image: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=200' },
        { id: 89, name: 'Tegan Quin', specialization: 'Musical Identity Therapist', experience: '15 years', rating: 4.8, city: 'calgary', image: 'https://images.unsplash.com/photo-1548142813-c348350df52b?auto=format&fit=crop&q=80&w=200' },

        // Canada - Ottawa
        { id: 90, name: 'Alanis Morissette', specialization: 'Expressive Release Therapist', experience: '18 years', rating: 4.9, city: 'ottawa', image: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&q=80&w=200' },
        { id: 91, name: 'Matthew Perry', specialization: 'Resilience Coach', experience: '14 years', rating: 4.8, city: 'ottawa', image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=200' },
        { id: 92, name: 'Margaret Atwood', specialization: 'Reflective Narrative Counselor', experience: '30 years', rating: 5.0, city: 'ottawa', image: 'https://images.unsplash.com/photo-1573166364524-d9dbfd8bbf83?auto=format&fit=crop&q=80&w=200' },
    ];

    const handleBack = () => {
        if (showResults) {
            setShowResults(false);
        } else {
            navigate(-1);
        }
    };

    const handleCountryChange = (e) => {
        setSelectedCountry(e.target.value);
        setSelectedCity('');
    };

    const handleFindCounsellors = () => {
        if (!selectedCity) return;
        const results = mockCounsellors.filter(c => c.city === selectedCity);
        setFilteredCounsellors(results);
        setShowResults(true);
    };

    return (
        <div className="app-container" style={{
            backgroundImage: `url(${mainBg})`,
            backgroundSize: 'cover',
            backgroundPosition: 'center',
            display: 'flex',
            justifyContent: 'center',
            alignItems: 'flex-start',
            paddingTop: '4rem',
            minHeight: '100vh',
            overflowY: 'auto'
        }}>
            {/* Back Button */}
            <button className="nav-btn" onClick={handleBack} style={{
                position: 'fixed',
                top: '2rem',
                left: '2rem',
                zIndex: 100,
                background: 'rgba(255, 255, 255, 0.4)',
                backdropFilter: 'blur(10px)',
                border: '1px solid rgba(255, 255, 255, 0.3)'
            }}>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" style={{ marginRight: '8px' }}>
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                {showResults ? 'Back to Search' : 'Back'}
            </button>

            <div className="animate-fade-in" style={{ textAlign: 'center', width: '90%', maxWidth: showResults ? '1000px' : '800px', padding: '2rem 4rem', marginBottom: '4rem' }}>
                <h1 className="gradient-text" style={{ fontSize: showResults ? '4rem' : '5rem', fontWeight: '900', marginBottom: '1rem', marginTop: '0.5rem', letterSpacing: '-2px', lineHeight: '1.1' }}>
                    {showResults ? `Counsellors in ${selectedCity.charAt(0).toUpperCase() + selectedCity.slice(1)}` : 'Book A Counsellor'}
                </h1>

                {!showResults ? (
                    <>
                        <p style={{ color: '#ffffff', fontSize: '1.25rem', marginBottom: '3rem', fontWeight: '500' }}>
                            Find professional support tailored to your location.
                        </p>

                        <div style={{ display: 'flex', flexDirection: 'column', gap: '2rem', alignItems: 'center' }}>
                            {/* Country Selector */}
                            <div style={{ width: '100%', maxWidth: '400px', textAlign: 'left' }}>
                                <label style={{ color: '#ffffff', display: 'block', marginBottom: '0.75rem', fontWeight: '700', fontSize: '1.1rem' }}>Select your Country</label>
                                <select
                                    className="glass-input"
                                    style={{ width: '100%', marginBottom: '0', background: '#ffffff', color: '#000000', opacity: 1 }}
                                    value={selectedCountry}
                                    onChange={handleCountryChange}
                                >
                                    <option value="">Choose your country...</option>
                                    {Object.keys(locationData).map(country => (
                                        <option key={country} value={country}>{country}</option>
                                    ))}
                                </select>
                            </div>

                            {/* City Selector - Dependent on Country */}
                            <div style={{
                                width: '100%',
                                maxWidth: '400px',
                                textAlign: 'left',
                                transition: 'all 0.3s ease'
                            }}>
                                <label style={{ color: '#ffffff', display: 'block', marginBottom: '0.75rem', fontWeight: '700', fontSize: '1.1rem' }}>Select your City</label>
                                <select
                                    className="glass-input"
                                    style={{ width: '100%', marginBottom: '0', background: '#ffffff', color: '#000000', opacity: 1 }}
                                    value={selectedCity}
                                    onChange={(e) => setSelectedCity(e.target.value)}
                                    disabled={!selectedCountry}
                                >
                                    <option value="">
                                        {!selectedCountry ? 'Select a country first...' : 'Choose your city...'}
                                    </option>
                                    {selectedCountry && locationData[selectedCountry].map(city => (
                                        <option key={city} value={city.toLowerCase()}>{city}</option>
                                    ))}
                                </select>
                            </div>

                            <button
                                className="nav-btn logout-primary-btn"
                                onClick={handleFindCounsellors}
                                style={{
                                    padding: '1.2rem 4rem',
                                    fontSize: '1.3rem',
                                    fontWeight: '800',
                                    borderRadius: '50px',
                                    marginTop: '1rem',
                                    cursor: selectedCity ? 'pointer' : 'not-allowed',
                                    opacity: selectedCity ? 1 : 0.7
                                }}
                                disabled={!selectedCity}
                            >
                                Find Counsellors
                            </button>
                        </div>
                    </>
                ) : (
                    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(300px, 1fr))', gap: '2rem', marginTop: '3rem' }}>
                        {filteredCounsellors.length > 0 ? (
                            filteredCounsellors.map(counsellor => (
                                <div key={counsellor.id} className="glass-panel" style={{ padding: '2rem', textAlign: 'left', display: 'flex', flexDirection: 'column', gap: '1rem', animationDelay: `${counsellor.id * 0.1}s` }}>
                                    <div style={{ display: 'flex', alignItems: 'center', gap: '1.5rem', marginBottom: '0.5rem' }}>
                                        <img src={counsellor.image} alt={counsellor.name} style={{ width: '80px', height: '80px', borderRadius: '50%', objectFit: 'cover', border: '3px solid var(--color-blue)' }} />
                                        <div>
                                            <h3 style={{ margin: 0, fontSize: '1.4rem', color: 'var(--text-primary)' }}>{counsellor.name}</h3>
                                            <p style={{ margin: 0, color: 'var(--color-blue)', fontWeight: '700', fontSize: '0.9rem' }}>{counsellor.specialization}</p>
                                        </div>
                                    </div>

                                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '0.75rem 0', borderTop: '1px solid rgba(0,0,0,0.05)', borderBottom: '1px solid rgba(0,0,0,0.05)' }}>
                                        <span style={{ fontSize: '0.9rem', color: 'var(--text-secondary)' }}>Exp: <strong>{counsellor.experience}</strong></span>
                                        <div style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="var(--color-orange)" stroke="var(--color-orange)" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                            <span style={{ fontWeight: '800', fontSize: '1rem' }}>{counsellor.rating}</span>
                                        </div>
                                    </div>

                                    <button className="nav-btn logout-primary-btn" style={{ width: '100%', marginTop: 'auto', padding: '1rem' }}>
                                        Book Session
                                    </button>
                                </div>
                            ))
                        ) : (
                            <div className="glass-panel" style={{ gridColumn: '1 / -1', padding: '4rem', color: 'var(--text-primary)' }}>
                                <h2 style={{ marginBottom: '1rem' }}>No Counsellors Found</h2>
                                <p style={{ color: 'var(--text-secondary)' }}>We currently don't have available counsellors in this city. Try selecting another city like Delhi or Mumbai.</p>
                                <button className="nav-btn" onClick={() => setShowResults(false)} style={{ marginTop: '2rem' }}>Back to Search</button>
                            </div>
                        )}
                    </div>
                )}
            </div>

            {/* Decorative background elements */}
            <div className="glow-orb orb-1" style={{ position: 'fixed' }}></div>
            <div className="glow-orb orb-2" style={{ position: 'fixed' }}></div>
        </div>
    );
};

export default BookACounsellor;
